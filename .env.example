# ------------------------------------------------------------------
# متغیرهای محیطی
# ------------------------------------------------------------------
# این فایل فقط نمونه است. مقادیر واقعی را در Netlify
# (Site settings → Environment variables) تنظیم کنید.
# هیچ‌کدام از مقادیر حساس نباید به کد فرانت‌اند یا مخزن اضافه شود.
# ------------------------------------------------------------------

# --- عمومی (در زمان بیلد در فرانت‌اند جاسازی می‌شود) -----------------
# نشانی نهایی سایت؛ بدون اسلش انتهایی
VITE_SITE_URL=https://leyla-abkeh.ir

# کلید عمومی Turnstile (اختیاری). اگر تنظیم شود، ویجت ضد‌هرزنامه نمایش
# داده می‌شود و سرور هم توکن را الزامی می‌کند.
# VITE_TURNSTILE_SITE_KEY=

# --- فقط سرور (Netlify Functions) — هرگز در فرانت‌اند استفاده نشود ---

# ارسال اعلان به تلگرام (ساده‌ترین گزینه)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# یا ارسال ایمیل با Resend
# RESEND_API_KEY=
# CONSULTATION_NOTIFY_EMAIL=office@example.com
# CONSULTATION_FROM_EMAIL=no-reply@example.com

# یا وب‌هوک عمومی (CRM، Zapier، Make و …)
# CONSULTATION_WEBHOOK_URL=
# CONSULTATION_WEBHOOK_SECRET=

# کلید مخفی Turnstile (فقط اگر Turnstile فعال است)
# TURNSTILE_SECRET_KEY=

# --- سنجش حریم‌خصوصی‌محور (اختیاری) -----------------------------------
# اگر تنظیم شود، رویدادهای بی‌نام (بدون نام/شماره/متن پیام) به این نشانی
# فرستاده می‌شوند. بدون این متغیر، هیچ درخواستی ارسال نمی‌شود.
# VITE_ANALYTICS_ENDPOINT=
# VITE_ANALYTICS_DEBUG=1

# --- حالت استقرار ایستا ------------------------------------------------
# روی GitHub Pages (بدون سرور) این مقدار را static بگذارید تا فرم
# وضعیت واقعی «ارسال فعال نیست» را نشان دهد، نه خطای شبکه.
# VITE_FORM_MODE=static
